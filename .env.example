# Copy to .env.local for local dev, and set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=contact@gasperohlab.com

# Sender. The domain MUST be verified in Resend (Domains → Add domain,
# then add the DNS records). Example: "GASPEROHLAB <noreply@gasperohlab.com>"
CONTACT_FROM_EMAIL=GASPEROHLAB <noreply@gasperohlab.com>

# --- Durable storage & rate limiting (optional but strongly recommended) ---
#
# Without these, a beta signup exists only as an email — if the send fails, the
# address is lost after the visitor has already been told they're on the list.
# Rate limiting also falls back to a per-instance in-memory window, which on a
# serverless platform means the real limit is a multiple of the configured one.
#
# Create a Redis database at https://console.upstash.com and copy its REST
# credentials. Records land in the `gohl:waitlist` and `gohl:contact` lists.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Search Console verification token (optional).
GOOGLE_SITE_VERIFICATION=
